<div class="terminal-preview dark" id="terminalPreview">

    <div class="terminal-titlebar">

        <div class="terminal-controls">

            <span class="control close"></span>
            <span class="control minimize"></span>
            <span class="control maximize"></span>

        </div>

    </div>

    <div class="terminal-body">

        <div class="terminal-prompt">

            <span id="tp-user" class="seg user">minima</span>

            <span class="plain">@</span>

            <span id="tp-host" class="seg host">simplicity</span>

            <span class="plain">&nbsp;</span>

            <span id="tp-path" class="seg path">~</span>

            <span id="tp-extra"></span>

            <span class="plain">&nbsp;</span>

            <span id="tp-symbol" class="seg symbol">$</span>

            <span class="cursor"></span>

        </div>


    </div>

</div>